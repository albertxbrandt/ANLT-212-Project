{
  "name": "simple-start",
  "version": "0.1.0",
  "description": "PantryPal household inventory tracker",
  "main": "main.js",
  "homepage": "./",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -u src/app.py",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "start": "python backend/src/app.py",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python3 -m pytest tests -q || python -m pytest tests -q",
    "test:frontend": "npm test --prefix frontend",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
